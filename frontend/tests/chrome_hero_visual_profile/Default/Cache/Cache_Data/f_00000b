ont-size: 10px;\n  font-weight: 800;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  padding: 2px 8px;\n  border-radius: var(--radius-micro);\n}\n\n.tag-negative {\n  background: var(--status-missing-bg, #FDF0F2);\n  color: var(--status-missing-text, #962532);\n}\n\n.tag-positive {\n  background: var(--status-verified-bg, #EDF7F2);\n  color: var(--status-verified-text, #0E5E38);\n}\n\n.contrast-title {\n  font-size: 16.5px;\n  font-weight: 700;\n  color: var(--color-text-primary, #252337);\n  margin: 0 0 12px 0;\n}\n\n.contrast-list {\n  margin: 0;\n  padding-left: 20px;\n  color: var(--color-text-secondary, #666477);\n  font-size: 13.5px;\n  line-height: 1.7;\n}\n\n/* Section B: What FORMLESS Does (Workflow Grid) */\n.workflow-section {\n  background-color: var(--color-canvas, #F8F7F4);\n}\n\n.section-header-centered {\n  text-align: center;\n  max-width: 680px;\n  margin: 0 auto 60px auto;\n}\n\n.workflow-steps-grid {\n  display: grid;\n  grid-template-columns: repeat(5, 1fr);\n  gap: 18px;\n}\n\n.workflow-step-card {\n  padding: 28px 20px;\n  background: #FFFFFF;\n  border: 1px solid var(--color-border, #E5E0F2);\n  border-radius: 12px;\n  display: flex;\n  flex-direction: column;\n  position: relative;\n  transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);\n  box-shadow: 0 4px 16px rgba(48, 41, 67, 0.04);\n}\n\n.workflow-step-card:hover {\n  transform: translateY(-4px);\n  border-color: var(--color-accent-violet, #7965C7);\n  box-shadow: 0 12px 32px rgba(121, 101, 199, 0.12);\n}\n\n.step-number-tag {\n  font-family: var(--font-mono);\n  font-size: 14px;\n  font-weight: 800;\n  color: var(--color-accent-violet, #7965C7);\n  margin-bottom: 14px;\n}\n\n.step-title {\n  font-size: 16px;\n  font-weight: 700;\n  color: var(--color-text-primary, #252337);\n  margin: 0 0 10px 0;\n  line-height: 1.3;\n}\n\n.step-description {\n  font-size: 12.5px;\n  line-height: 1.6;\n  color: var(--color-text